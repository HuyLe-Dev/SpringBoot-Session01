{
  "info": {
    "name": "Product Management Tests",
    "description": "Collection test 4 API CRUD cho bảng Product",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Get All Products",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/api/products",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "products"]
        }
      }
    },
    {
      "name": "2. Add Product",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Laptop Dell XPS\",\n  \"price\": 1500.0\n}"
        },
        "url": {
          "raw": "http://localhost:8080/api/products",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "products"]
        }
      }
    },
    {
      "name": "3. Update Product",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Laptop Dell XPS (Updated)\",\n  \"price\": 1800.0\n}"
        },
        "url": {
          "raw": "http://localhost:8080/api/products/1",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "products", "1"]
        }
      }
    },
    {
      "name": "4. Delete Product",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/api/products/1",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "products", "1"]
        }
      }
    }
  ]
}